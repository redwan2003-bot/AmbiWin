<Window x:Class="AmbiWin.App.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AmbiWin mini player"
        Width="380" Height="116"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ThemeMode="None" Background="Transparent" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/Assets/AmbiWin.ico">
  <WindowChrome.WindowChrome>
    <!-- Keeps the DWM frame (rounded corners, shadow, glass) without a title bar. -->
    <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="16" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Background="#01000000" MouseLeftButtonDown="OnDrag" MouseEnter="OnHover" MouseLeave="OnHover">
    <!-- Liquid tint: the glow's colors washed over the blurred desktop. -->
    <Border IsHitTestVisible="False" Opacity="0.42">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop x:Name="TintA" Color="#7C5CFF" Offset="0" />
          <GradientStop x:Name="TintB" Color="#00D1FF" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <!-- Sheen and rim light, which is what reads as "glass". -->
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#30FFFFFF" Offset="0" />
          <GradientStop Color="#0AFFFFFF" Offset="0.45" />
          <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border IsHitTestVisible="False" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="8" />

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="92" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Width="92" Height="92" CornerRadius="10" Background="#33000000">
        <Grid>
          <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="30"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
          <Border CornerRadius="10">
            <Border.Background>
              <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <Border CornerRadius="10" BorderBrush="#26FFFFFF" BorderThickness="1" />
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="14.5" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" Margin="0,0,22,0" />
        <TextBlock x:Name="ArtistText" Grid.Row="1" Text="Play something to see it here" FontSize="12.5" Opacity="0.72"
                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />

        <Grid x:Name="ProgressRow" Grid.Row="3" Margin="0,0,0,2">
          <Border x:Name="ProgressTrack" Height="3" CornerRadius="1.5" Background="#38FFFFFF" />
          <Border x:Name="ProgressFill" Height="3" CornerRadius="1.5" Background="White" HorizontalAlignment="Left" Width="0" />
        </Grid>

        <Grid Grid.Row="4">
          <TextBlock x:Name="ElapsedText" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Content="&#xE892;" Click="OnPrevious" ToolTip="Previous" />
            <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="17"
                    Width="38" Height="38" Margin="4,0" Click="OnPlayPause" ToolTip="Play / pause" />
            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" Click="OnNext" ToolTip="Next" />
          </StackPanel>
          <TextBlock x:Name="DurationText" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Grid>

    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9" Width="24" Height="24"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed"
            Click="OnClose" ToolTip="Hide (Ctrl+Alt+M)" />
  </Grid>
</Window>
