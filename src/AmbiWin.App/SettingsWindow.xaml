<Window x:Class="AmbiWin.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AmbiWin settings"
        Width="500" Height="760" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AmbiWin.ico">
  <Window.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,22,0,8" />
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,6" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,24">
      <TextBlock Text="AmbiWin" FontSize="26" FontWeight="SemiBold" />
      <TextBlock x:Name="NowPlayingText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      <CheckBox x:Name="EnabledBox" Content="Glow on" Margin="0,12,0,0" Checked="OnChanged" Unchecked="OnChanged" />

      <!-- Motion -->
      <TextBlock Text="Motion" Style="{StaticResource SectionHeader}" />
      <RadioButton x:Name="MusicRadio" GroupName="Motion" Content="Pulse with music" Checked="OnChanged" />
      <RadioButton x:Name="IdleRadio" GroupName="Motion" Content="Steady glow" Checked="OnChanged" Margin="0,6,0,0" />

      <!-- Color -->
      <TextBlock Text="Color" Style="{StaticResource SectionHeader}" />
      <RadioButton x:Name="AlbumRadio" GroupName="ColorSource" Content="From the playing song's album art" Checked="OnChanged" />
      <RadioButton x:Name="ManualRadio" GroupName="ColorSource" Content="My colors" Checked="OnChanged" Margin="0,6,0,0" />
      <TextBlock Style="{StaticResource Hint}" Text="Your colors are also used when nothing is playing." />

      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="Main color" Style="{StaticResource RowLabel}" />
        <Border x:Name="PrimarySwatch" Grid.Column="1" Width="26" Height="26" CornerRadius="5" BorderThickness="1" BorderBrush="#40808080" />
        <TextBox x:Name="PrimaryHex" Grid.Column="2" Margin="6,4" LostFocus="OnHexCommitted" KeyDown="OnHexKeyDown" />
        <Button Grid.Column="3" Content="Pick…" Click="OnPickPrimary" />
        <TextBlock Grid.Row="1" Text="Second color" Style="{StaticResource RowLabel}" />
        <Border x:Name="SecondarySwatch" Grid.Row="1" Grid.Column="1" Width="26" Height="26" CornerRadius="5" BorderThickness="1" BorderBrush="#40808080" />
        <TextBox x:Name="SecondaryHex" Grid.Row="1" Grid.Column="2" Margin="6,4" LostFocus="OnHexCommitted" KeyDown="OnHexKeyDown" />
        <Button Grid.Row="1" Grid.Column="3" Content="Pick…" Click="OnPickSecondary" />
      </Grid>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Color balance" Style="{StaticResource RowLabel}" />
        <TextBlock x:Name="MixValue" Grid.Column="1" Style="{StaticResource RowValue}" />
      </Grid>
      <Slider x:Name="MixSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />

      <!-- Shape -->
      <TextBlock Text="Shape" Style="{StaticResource SectionHeader}" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Brightness" Style="{StaticResource RowLabel}" />
        <TextBlock x:Name="IntensityValue" Grid.Column="1" Style="{StaticResource RowValue}" />
      </Grid>
      <Slider x:Name="IntensitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Edge thickness" Style="{StaticResource RowLabel}" />
        <TextBlock x:Name="ThicknessValue" Grid.Column="1" Style="{StaticResource RowValue}" />
      </Grid>
      <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Glow reach" Style="{StaticResource RowLabel}" />
        <TextBlock x:Name="SpreadValue" Grid.Column="1" Style="{StaticResource RowValue}" />
      </Grid>
      <Slider x:Name="SpreadSlider" Minimum="0" Maximum="200" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Corner roundness" Style="{StaticResource RowLabel}" />
        <TextBlock x:Name="CornerValue" Grid.Column="1" Style="{StaticResource RowValue}" />
      </Grid>
      <Slider x:Name="CornerSlider" Minimum="0" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />

      <!-- Music -->
      <TextBlock Text="Music" Style="{StaticResource SectionHeader}" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Beat sensitivity" Style="{StaticResource RowLabel}" />
        <TextBlock x:Name="SensitivityValue" Grid.Column="1" Style="{StaticResource RowValue}" />
      </Grid>
      <Slider x:Name="SensitivitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Headphone delay" Style="{StaticResource RowLabel}" />
        <TextBlock x:Name="DelayValue" Grid.Column="1" Style="{StaticResource RowValue}" />
      </Grid>
      <Slider x:Name="DelaySlider" Minimum="0" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
      <TextBlock Style="{StaticResource Hint}" Text="Bluetooth headphones play sound a little late. If the light lands before the beat, raise this until they match." />

      <!-- General -->
      <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
      <CheckBox x:Name="StartupBox" Content="Start with Windows" Checked="OnChanged" Unchecked="OnChanged" />
      <CheckBox x:Name="CaptureBox" Content="Hide the glow from screenshots, recordings and screen shares" Margin="0,8,0,0" Checked="OnChanged" Unchecked="OnChanged" />
      <TextBlock Style="{StaticResource Hint}" Text="Turn this off to record a demo of AmbiWin." />
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
        <TextBlock Text="In fullscreen apps" Style="{StaticResource RowLabel}" />
        <ComboBox x:Name="FullscreenCombo" Grid.Column="1" Margin="0,4" SelectionChanged="OnSelectionChanged">
          <ComboBoxItem Content="Keep glowing" />
          <ComboBoxItem Content="Hide on that screen" />
          <ComboBoxItem Content="Hide on all screens" />
        </ComboBox>
        <TextBlock Grid.Row="1" Text="On battery" Style="{StaticResource RowLabel}" />
        <ComboBox x:Name="BatteryCombo" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="OnSelectionChanged">
          <ComboBoxItem Content="Full speed" />
          <ComboBoxItem Content="Save power (30 fps)" />
          <ComboBoxItem Content="Steady glow only" />
        </ComboBox>
      </Grid>

      <!-- Footer -->
      <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
        <Button Content="Reset to defaults" Click="OnReset" />
        <Button Content="Open log folder" Click="OnOpenLogs" Margin="8,0,0,0" />
      </StackPanel>
      <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,12,0,0" />
      <TextBlock Style="{StaticResource Hint}"
                 Text="Free and open source (MIT). Audio is analyzed on this PC and never recorded or uploaded." />
    </StackPanel>
  </ScrollViewer>
</Window>
