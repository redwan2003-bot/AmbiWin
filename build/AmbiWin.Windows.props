<Project>
  <!-- Imported by every Windows-only project. Windows 11 (build 22000) is the minimum supported OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <!-- Native AOT is deferred to v1.1; v1.0 ships a self-contained single-file exe. -->
    <IsAotCompatible>false</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
